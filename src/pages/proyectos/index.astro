---
// Proyectos: cifras, mapa Leaflet y listado filtrable, todo a partir de src/data/obras.json.
// Ver docs/ARQUITECTURA.md (contrato) y docs/DATOS-OBRAS.md (arreglos de presentación y dudas de datos).
import Base from '../../layouts/Base.astro';
import FondoAero from '../../components/FondoAero.astro';
import CifrasObras from '../../components/CifrasObras.astro';
import ExploradorObras from '../../components/proyectos/ExploradorObras.astro';
import { cifrasObras } from '../../lib/obras';

const c = cifrasObras();
---
<Base
  titulo="Proyectos"
  descripcion={`Mapa de las obras de Mixan en cimentaciones especiales y mejora del terreno.`}
>
  <FondoAero variante="hero" aria-labelledby="titulo-proyectos">
    <div class="contenedor proyectos-hero">
      <div class="cristal hero-pagina">
        <p class="titulillo">Proyectos</p>
        <h1 id="titulo-proyectos">Nuestros proyectos realizados</h1>
        <p class="proyectos-hero__entradilla">Obras ejecutadas por MIXAN, con su cliente, año, provincia y metros lineales.</p>
      </div>
      <CifrasObras variante="fila" />
    </div>
  </FondoAero>

  <section class="seccion seccion--obras" aria-label="Mapa y listado de obras">
    <div class="contenedor">
      <ExploradorObras />
    </div>
  </section>
</Base>

<style>
  .proyectos-hero { display: grid; gap: var(--e-5); }
  .hero-pagina { padding: var(--e-6); max-width: 46rem; }
  .hero-pagina h1 { margin: 0 0 var(--e-3); }
  .proyectos-hero__entradilla { margin: 0; font-size: var(--fs-2); color: var(--c-tinta); }
  @media (max-width: 767px) { .hero-pagina { padding: var(--e-5); } }
  .seccion--obras { padding-top: var(--e-6); }
</style>
