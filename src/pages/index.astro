---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FondoAero from '../components/FondoAero.astro';
import MaquinaCimentacion from '../components/MaquinaCimentacion.astro';
import CifrasObras from '../components/CifrasObras.astro';
import UltimasNoticias from '../components/UltimasNoticias.astro';
import FichaObra from '../components/proyectos/FichaObra.astro';
import { obrasDestacadas } from '../lib/obras';
import { documentos } from '../data/sitio';
import icono1 from '../assets/img/icono1.png';
import icono2 from '../assets/img/icono2.png';
import icono3 from '../assets/img/icono3.png';
import icono4 from '../assets/img/icono4.png';
import fotoEquipo from '../assets/img/equipo-obra.png';
import fotoCentral from '../assets/img/foto-central.jpg';
import fotoDron from '../assets/img/dron-obra.jpeg';
import ditPortada from '../assets/img/dit-portada.png';

// Textos de la web antigua (contenido-recuperado.md → Inicio). Anclajes no tenía descripción utilizable.
const especialidades = [
  { icono: icono1, titulo: 'Mixpile®', texto: 'Mixan propone y realiza soluciones de cimentación basadas en la mejora del terreno.', href: '/mixpile/' },
  { icono: icono2, titulo: 'Pilotes y micropilotes', texto: 'Nuestros tratamientos de suelos permiten reducir el coste de los elementos de cimentación.' },
  { icono: icono4, titulo: 'Inyecciones', texto: 'Soluciones de cimentación que reducen los tiempos de ejecución de las obras.' },
  { icono: icono3, titulo: 'Anclajes', texto: null },
];
// Obras destacadas: las 4 de mayor medición de obras.json (criterio en src/lib/obras.ts → obrasDestacadas).
const destacadas = obrasDestacadas(4);
const servicios = ['Mejoras en el terreno', 'Pilotes y micropilotes', 'Rehabilitación técnica', 'Marítimas Fabriform®'];
---
<Base
  titulo="Inicio"
  tituloCompleto="MIXAN · Cimentaciones especiales e inclusiones rígidas Mixpile®"
  descripcion="MIXAN Mix Andalucía, S.L.: más de 25 años en cimentaciones especiales. Mejora del terreno con inclusiones rígidas Mixpile® (DIT), pilotes, micropilotes, inyecciones y anclajes."
>
  <FondoAero variante="hero" aria-labelledby="titulo-inicio">
    <div class="contenedor inicio-hero">
      <div class="cristal inicio-hero__tarjeta">
        <p class="titulillo">Nuestra compañía</p>
        <h1 id="titulo-inicio">Pioneros en el sector de las <span class="resalte">cimentaciones especiales</span></h1>
        <p class="entradilla">Más de 20 años desarrollando soluciones innovadoras.</p>
        <div class="botones">
          <a class="boton" href="/mixpile/">Conocer Mixpile®</a>
          <a class="boton boton--borde" href="/contacto/">Contacto</a>
        </div>
      </div>
      <MaquinaCimentacion class="inicio-hero__maquina" />
    </div>
  </FondoAero>

  <section class="seccion" aria-labelledby="titulo-especialidades">
    <div class="contenedor">
      <h2 id="titulo-especialidades" class="visualmente-oculto">Especialidades</h2>
      <ul class="rejilla especialidades" role="list">
        {especialidades.map((e) => (
          <li class="tarjeta especialidad">
            <Image src={e.icono} alt="" width={48} densities={[1, 2]} class="especialidad__icono" />
            <h3>{e.href ? <a href={e.href}>{e.titulo}</a> : e.titulo}</h3>
            {e.texto && <p>{e.texto}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FondoAero variante="banda" aria-labelledby="titulo-dit">
    <div class="contenedor pareja">
      <div class="cristal banda-dit__tarjeta">
        <p class="titulillo">Mixpile®</p>
        <h2 id="titulo-dit"><strong>Mixan</strong>, primera empresa española que ha obtenido un DIT, evaluado por el Instituto Torroja del CSIC en sistemas de mejora del terreno.</h2>
        <p>Como fruto de nuestra vocación innovadora, en los primeros 5 años de andadura se desarrolló un intenso programa de investigación, que culminó en 2011 con la obtención del Documento de Idoneidad Técnica (DIT) del sistema de mejora de terrenos Mixpile®.</p>
        <div class="botones">
          <a class="boton" href="/mixpile/">Conocer Mixpile®</a>
          <a class="boton boton--claro" href={documentos.dit.href}>Ver el DIT (PDF)</a>
        </div>
      </div>
      <a class="banda-dit__portada" href={documentos.dit.href} aria-label="Abrir el Documento de Idoneidad Técnica de Mixpile® (PDF)">
        <Image src={ditPortada} alt="Portada del Documento de Idoneidad Técnica n.º 576R/24 de Mixpile®, emitido por el Instituto Eduardo Torroja" width={560} class="foto" />
      </a>
    </div>
  </FondoAero>

  <section class="seccion" aria-labelledby="titulo-servicios">
    <div class="contenedor pareja">
      <div>
        <h2 id="titulo-servicios">Servicios</h2>
        <ul class="lista-servicios">
          {servicios.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <Image src={fotoEquipo} alt="Técnicos de MIXAN controlando la ejecución en obra junto a la máquina" widths={[480, 780]} width={780} sizes="(min-width: 900px) 560px, 100vw" class="foto" />
    </div>
  </section>

  <section class="seccion seccion--crema" aria-labelledby="titulo-quienes">
    <div class="contenedor pareja pareja--invertida">
      <div>
        <p class="titulillo">Quiénes somos</p>
        <h2 id="titulo-quienes">Más de 20 años de experiencia</h2>
        <p>Somos una empresa con más de 20 años de experiencia en el estudio, planificación y ejecución de soluciones técnicas en el campo de las cimentaciones especiales. Nuestros comienzos se remontan a la década de los 90 cuando un grupo de ingenieros y arquitectos provenientes de empresas dedicadas a la ejecución de pilotes, inyecciones y anclajes, deciden continuar esta actividad incorporando nuevos procedimientos y sistemas a los ya existentes.</p>
        <a class="boton boton--borde" href="/quienes-somos/">Leer más</a>
      </div>
      <Image src={fotoCentral} alt="Máquina de MIXAN trabajando en una obra" widths={[480, 800, 1120]} width={1120} sizes="(min-width: 900px) 560px, 100vw" class="foto foto--alta" />
    </div>
  </section>

  <section class="seccion" aria-labelledby="titulo-proyectos">
    <div class="contenedor pareja">
      <div>
        <p class="titulillo">Proyectos</p>
        <h2 id="titulo-proyectos">Nuestros proyectos realizados</h2>
        <CifrasObras />
        <a class="boton" href="/proyectos/">Ver los proyectos</a>
      </div>
      <Image src={fotoDron} alt="Vista aérea desde dron de una obra de MIXAN" widths={[480, 800, 1120]} width={1120} sizes="(min-width: 900px) 560px, 100vw" class="foto" />
    </div>
  </section>
  <UltimasNoticias class="seccion--crema" />
</Base>

<style>
  .inicio-hero { display: grid; align-items: center; gap: var(--e-6); }
  .inicio-hero__tarjeta { padding: var(--e-6) var(--e-6) var(--e-6); max-width: 38rem; }
  .inicio-hero__tarjeta h1 { margin-bottom: var(--e-4); }
  .resalte { color: var(--c-naranja); }
  :global(.inicio-hero__maquina) { width: 100%; max-width: 620px; height: auto; justify-self: end; filter: drop-shadow(0 10px 24px rgba(120, 60, 10, 0.25)); }
  @media (min-width: 900px) {
    .inicio-hero { grid-template-columns: 1.05fr 1fr; min-height: 420px; }
  }
  @media (max-width: 899px) {
    .inicio-hero__tarjeta { padding: var(--e-5); }
    :global(.inicio-hero__maquina) { max-width: 340px; margin: calc(-1 * var(--e-5)) auto 0; }
  }

  .especialidades { list-style: none; padding: 0; margin: 0; }
  .especialidad { display: flex; flex-direction: column; gap: var(--e-2); }
  .especialidad h3 { margin: var(--e-2) 0 0; }
  .especialidad h3 a { color: inherit; }
  .especialidad p { color: var(--c-texto-suave); margin: 0; }
  :global(.especialidad__icono) { width: 48px; height: 48px; object-fit: contain; }

  .banda-dit__tarjeta { padding: var(--e-6); }
  .banda-dit__tarjeta h2 { font-size: var(--fs-3); font-weight: 600; }
  .banda-dit__tarjeta h2 strong { color: var(--c-naranja); }
  .banda-dit__portada { display: block; max-width: 460px; justify-self: center; transition: transform 0.2s ease; }
  .banda-dit__portada:hover { transform: translateY(-3px); }
  @media (max-width: 767px) { .banda-dit__tarjeta { padding: var(--e-5); } }

  .lista-servicios { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--e-3); }
  .lista-servicios li {
    position: relative; padding: var(--e-3) var(--e-4) var(--e-3) var(--e-7);
    background: var(--c-crema); border-radius: var(--radio); font-weight: 600; font-size: var(--fs-2);
  }
  .lista-servicios li::before {
    content: ""; position: absolute; left: var(--e-4); top: 50%; width: 14px; height: 14px; margin-top: -7px;
    border-radius: 50%; background: radial-gradient(circle at 35% 35%, #ffd2a6, var(--c-naranja));
    box-shadow: 0 0 0 4px rgba(230, 119, 23, 0.15);
  }
  .destacadas { margin-top: var(--e-7); }
  .destacadas__titulo { font-size: var(--fs-3); }
  .destacadas__lista { list-style: none; padding: 0; margin: 0; }
  :global(.foto--alta) { aspect-ratio: 4 / 3; }
</style>
