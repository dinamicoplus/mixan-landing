---
// Página de una noticia: /noticias/<slug>/ (slug = nombre del fichero .md sin extensión).
// Las rutas salen de getNoticiasPublicadas(): los borradores no se generan ni se enlazan.
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FondoAero from '../../components/FondoAero.astro';
import { empresa } from '../../data/sitio';
import logo from '../../assets/img/logo-mixan.jpg';
import {
  getNoticiasPublicadas,
  formatearFecha,
  fechaIso,
  urlNoticia,
  type Noticia,
} from '../../lib/noticias';

export async function getStaticPaths() {
  const publicadas = await getNoticiasPublicadas();
  // publicadas va de la más reciente a la más antigua.
  return publicadas.map((noticia, i) => ({
    params: { slug: noticia.id },
    props: {
      noticia,
      anterior: publicadas[i + 1], // publicada antes (más antigua)
      siguiente: publicadas[i - 1], // publicada después (más reciente)
    },
  }));
}

interface Props {
  noticia: Noticia;
  anterior?: Noticia;
  siguiente?: Noticia;
}
const { noticia, anterior, siguiente } = Astro.props;
const { titulo, fecha, resumen, imagen, imagenAlt, galeria = [] } = noticia.data;
const { Content } = await render(noticia);

// Datos estructurados NewsArticle (https://schema.org/NewsArticle).
const absoluta = (ruta: string) => new URL(ruta, Astro.site).href;
const imagenesLd = await Promise.all(
  [imagen, ...galeria.map((g) => g.imagen)]
    .filter((img): img is NonNullable<typeof img> => Boolean(img))
    .slice(0, 3)
    .map(async (img) => absoluta((await getImage({ src: img, width: 1200, format: 'jpg' })).src)),
);
const logoLd = await getImage({ src: logo, width: 340, format: 'png' });
const organizacion = {
  '@type': 'Organization',
  name: empresa.razonSocial,
  url: absoluta('/'),
  logo: { '@type': 'ImageObject', url: absoluta(logoLd.src) },
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: titulo,
  description: resumen,
  datePublished: fecha.toISOString(),
  dateModified: fecha.toISOString(),
  inLanguage: 'es-ES',
  mainEntityOfPage: { '@type': 'WebPage', '@id': absoluta(urlNoticia(noticia)) },
  ...(imagenesLd.length > 0 && { image: imagenesLd }),
  author: organizacion,
  publisher: organizacion,
};

// Galería: miniatura optimizada + versión grande para el visor.
const fotosGaleria = await Promise.all(
  galeria.map(async (g) => ({
    ...g,
    grande: await getImage({ src: g.imagen, width: Math.min(1800, g.imagen.width), format: 'webp' }),
  })),
);
---
<Base titulo={titulo} descripcion={resumen} imagen={imagen} articulo={{ publicado: fecha }}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <FondoAero variante="hero" aria-labelledby="titulo-noticia">
    <div class="contenedor">
      <div class="cristal hero-pagina">
        <p class="titulillo"><a href="/noticias/">Noticias</a></p>
        <h1 id="titulo-noticia">{titulo}</h1>
        <p class="noticia__fecha">Publicada el <time datetime={fechaIso(fecha)}>{formatearFecha(fecha)}</time></p>
      </div>
    </div>
  </FondoAero>

  <article class="seccion noticia" aria-labelledby="titulo-noticia">
    <div class="contenedor contenedor--texto">
      {imagen && (
        <Image
          src={imagen}
          alt={imagenAlt ?? ''}
          widths={[480, 800, 1200, 1600]}
          sizes="(min-width: 800px) 704px, calc(100vw - 32px)"
          loading="eager"
          fetchpriority="high"
          class="foto noticia__imagen"
        />
      )}

      <p class="entradilla noticia__resumen">{resumen}</p>

      <div class="prosa noticia__cuerpo">
        <Content />
      </div>

      {fotosGaleria.length > 0 && (
        <section class="galeria" aria-labelledby="titulo-galeria">
          <h2 id="titulo-galeria">Galería de fotos</h2>
          <ul class="galeria__lista" role="list">
            {fotosGaleria.map((f, i) => (
              <li>
                <a class="galeria__enlace" href={f.grande.src} data-indice={i} data-alt={f.alt}>
                  <Image
                    src={f.imagen}
                    alt={f.alt}
                    widths={[320, 480, 720]}
                    sizes="(min-width: 800px) 230px, (min-width: 600px) 30vw, 50vw"
                  />
                  <span class="visualmente-oculto">(ampliar foto {i + 1} de {fotosGaleria.length})</span>
                </a>
              </li>
            ))}
          </ul>
          <dialog class="visor" aria-label="Foto ampliada">
            <figure class="visor__figura">
              <img class="visor__img" alt="" />
              <figcaption class="visor__pie"></figcaption>
            </figure>
            <div class="visor__botones">
              <button type="button" class="boton boton--borde visor__anterior">← Anterior</button>
              <button type="button" class="boton boton--borde visor__siguiente">Siguiente →</button>
              <button type="button" class="boton visor__cerrar">Cerrar</button>
            </div>
          </dialog>
        </section>
      )}

      {(anterior || siguiente) && (
        <nav class="vecinas" aria-label="Otras noticias">
          {anterior && (
            <a class="vecinas__enlace vecinas__enlace--anterior" href={urlNoticia(anterior)} rel="prev">
              <span class="vecinas__rotulo"><span aria-hidden="true">←</span> Noticia anterior</span>
              <span class="vecinas__titulo">{anterior.data.titulo}</span>
            </a>
          )}
          {siguiente && (
            <a class="vecinas__enlace vecinas__enlace--siguiente" href={urlNoticia(siguiente)} rel="next">
              <span class="vecinas__rotulo">Noticia siguiente <span aria-hidden="true">→</span></span>
              <span class="vecinas__titulo">{siguiente.data.titulo}</span>
            </a>
          )}
        </nav>
      )}

      <p class="noticia__volver"><a class="boton boton--borde" href="/noticias/">← Volver a noticias</a></p>
    </div>
  </article>
</Base>

<script>
  // Visor de la galería: mejora progresiva. Sin JavaScript, cada miniatura abre la foto grande.
  const visor = document.querySelector<HTMLDialogElement>('.visor');
  const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('.galeria__enlace'));
  if (visor && enlaces.length && typeof visor.showModal === 'function') {
    const img = visor.querySelector<HTMLImageElement>('.visor__img')!;
    const pie = visor.querySelector<HTMLElement>('.visor__pie')!;
    const btnAnt = visor.querySelector<HTMLButtonElement>('.visor__anterior')!;
    const btnSig = visor.querySelector<HTMLButtonElement>('.visor__siguiente')!;
    let actual = 0;
    let origen: HTMLElement | null = null;
    const mostrar = (i: number) => {
      actual = (i + enlaces.length) % enlaces.length;
      const e = enlaces[actual];
      img.src = e.href;
      img.alt = e.dataset.alt ?? '';
      pie.textContent = `${e.dataset.alt ?? ''} (${actual + 1} de ${enlaces.length})`;
    };
    if (enlaces.length < 2) { btnAnt.hidden = true; btnSig.hidden = true; }
    enlaces.forEach((e, i) =>
      e.addEventListener('click', (ev) => {
        ev.preventDefault();
        origen = e;
        mostrar(i);
        visor.showModal();
      }),
    );
    btnAnt.addEventListener('click', () => mostrar(actual - 1));
    btnSig.addEventListener('click', () => mostrar(actual + 1));
    visor.querySelector('.visor__cerrar')!.addEventListener('click', () => visor.close());
    // Pulsar fuera de la foto (en el fondo) cierra.
    visor.addEventListener('click', (ev) => { if (ev.target === visor) visor.close(); });
    visor.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowLeft') mostrar(actual - 1);
      if (ev.key === 'ArrowRight') mostrar(actual + 1);
    });
    visor.addEventListener('close', () => { img.removeAttribute('src'); origen?.focus(); });
  }
</script>

<style>
  .titulillo a { color: inherit; text-decoration: none; }
  .titulillo a:hover { text-decoration: underline; }
  .noticia__fecha { margin: 0; color: var(--c-texto-suave); }

  .noticia { padding-top: var(--e-6); }
  .noticia :global(.noticia__imagen) { width: 100%; margin-bottom: var(--e-6); }
  .noticia__resumen { color: var(--c-tinta); font-weight: 500; }

  /* Contenido Markdown */
  .noticia__cuerpo :global(h2) { font-size: var(--fs-3); margin-top: var(--e-6); }
  .noticia__cuerpo :global(h3) { font-size: var(--fs-2); margin-top: var(--e-5); }
  .noticia__cuerpo :global(img) { border-radius: var(--radio); margin-block: var(--e-5); }
  .noticia__cuerpo :global(blockquote) {
    margin: var(--e-5) 0;
    padding: var(--e-2) var(--e-5);
    border-left: 4px solid var(--c-naranja);
    background: var(--c-naranja-suave);
    border-radius: 0 var(--radio) var(--radio) 0;
  }
  .noticia__cuerpo :global(blockquote p:last-child) { margin-bottom: 0; }
  .noticia__cuerpo :global(table) { width: 100%; border-collapse: collapse; margin-block: var(--e-5); display: block; overflow-x: auto; }
  .noticia__cuerpo :global(th), .noticia__cuerpo :global(td) { border: 1px solid var(--c-linea); padding: var(--e-2) var(--e-3); text-align: left; }
  .noticia__cuerpo :global(a) { overflow-wrap: anywhere; }

  /* Galería */
  .galeria { margin-top: var(--e-7); }
  .galeria h2 { font-size: var(--fs-3); }
  .galeria__lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--e-3);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 600px) { .galeria__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .galeria__enlace { display: block; border-radius: var(--radio); overflow: hidden; aspect-ratio: 4 / 3; background: var(--c-naranja-suave); }
  .galeria__enlace :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
  .galeria__enlace:hover :global(img) { transform: scale(1.04); }

  .visor {
    width: min(100vw - 2 * var(--gutter), 75rem);
    max-height: calc(100vh - 2 * var(--gutter));
    padding: var(--e-4);
    border: 0;
    border-radius: var(--radio-grande);
    background: var(--c-blanco);
    box-shadow: var(--sombra-cristal);
  }
  .visor::backdrop { background: rgba(43, 42, 40, 0.85); }
  .visor__figura { margin: 0; }
  .visor__img { width: 100%; max-height: calc(100vh - 13rem); object-fit: contain; margin-inline: auto; }
  .visor__pie { margin-top: var(--e-3); font-size: var(--fs-0); color: var(--c-texto-suave); text-align: center; }
  .visor__botones { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--e-2); margin-top: var(--e-3); }

  /* Anterior / siguiente */
  .vecinas {
    display: grid;
    gap: var(--e-4);
    margin-top: var(--e-7);
    padding-top: var(--e-6);
    border-top: 1px solid var(--c-linea);
  }
  @media (min-width: 600px) {
    .vecinas { grid-template-columns: 1fr 1fr; }
    .vecinas__enlace--siguiente { grid-column: 2; text-align: right; }
  }
  .vecinas__enlace {
    display: flex;
    flex-direction: column;
    gap: var(--e-1);
    padding: var(--e-4) var(--e-5);
    border: 1px solid var(--c-linea);
    border-radius: var(--radio);
    text-decoration: none;
    color: var(--c-tinta);
  }
  .vecinas__enlace:hover { background: var(--c-naranja-suave); border-color: var(--c-naranja); }
  .vecinas__rotulo { font-size: var(--fs-0); font-weight: 700; color: var(--c-naranja-oscuro); }
  .vecinas__titulo { font-weight: 650; }

  .noticia__volver { margin: var(--e-6) 0 0; }

  @media (prefers-reduced-motion: reduce) {
    .galeria__enlace :global(img) { transition: none; }
    .galeria__enlace:hover :global(img) { transform: none; }
  }
</style>
