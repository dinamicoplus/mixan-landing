---
/**
 * Ficha (tarjeta) de una obra. Se usa en el listado de /proyectos/ y en las destacadas de Inicio.
 * Muestra solo lo que consta en obras.json: la técnica, las fotos y la descripción únicamente si existen.
 *
 * Props:
 *  - obra: Obra
 *  - nivel: etiqueta del título (h2…h4). Por defecto h3.
 *  - enlace: si se pasa, el título enlaza a esa URL (p. ej. '/proyectos/#obra-39' desde Inicio).
 *  - compacta: oculta la descripción y deja solo la foto principal (Inicio).
 * Slot por defecto: acciones al pie (el botón «Ver en el mapa» del listado).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { type Obra, formatoMetros } from '../../lib/obras';

interface Props {
  obra: Obra;
  nivel?: 'h2' | 'h3' | 'h4';
  enlace?: string;
  compacta?: boolean;
}
const { obra, nivel: Titulo = 'h3', enlace, compacta = false } = Astro.props;

// Fotos de obras: src/assets/img/obras/. Se resuelven por nombre de fichero (o ruta relativa a esa carpeta).
const imagenes = import.meta.glob<{ default: ImageMetadata }>('../../assets/img/obras/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const fotos = (obra.fotos ?? []).map((ruta) => {
  const limpia = ruta.replace(/^(\.?\/)?(src\/)?(assets\/)?(img\/)?(obras\/)?/, '');
  const clave = `../../assets/img/obras/${limpia}`;
  const mod = imagenes[clave];
  if (!mod) throw new Error(`obras.json → obra ${obra.id}: no existe la foto «${ruta}» en src/assets/img/obras/`);
  return mod.default;
});
const fotosVisibles = compacta ? fotos.slice(0, 1) : fotos;
const idTitulo = `${enlace ? 'destacada' : 'obra'}-${obra.id}-titulo`;
---
<article class:list={['ficha', { 'ficha--con-foto': fotosVisibles.length > 0 }]} aria-labelledby={idTitulo}>
  {fotosVisibles.length > 0 && (
    <div class:list={['ficha__fotos', { 'ficha__fotos--varias': fotosVisibles.length > 1 }]}>
      {fotosVisibles.map((f, i) => (
        <Image
          src={f}
          alt={fotosVisibles.length > 1 ? `${obra.nombre}: foto ${i + 1} de ${fotosVisibles.length}` : `Foto de la obra ${obra.nombre}`}
          widths={i === 0 ? [400, 640, 960] : [240, 400]}
          sizes={i === 0 ? '(min-width: 1024px) 480px, (min-width: 640px) 50vw, 100vw' : '160px'}
          class:list={['ficha__foto', { 'ficha__foto--principal': i === 0 }]}
        />
      ))}
    </div>
  )}
  <div class="ficha__cuerpo">
    <Titulo id={idTitulo} class="ficha__titulo">
      {enlace ? <a href={enlace}>{obra.nombre}</a> : obra.nombre}
    </Titulo>
    <dl class="ficha__datos">
      <div><dt>Provincia</dt><dd>{obra.provincia}</dd></div>
      {obra.cliente && <div><dt>Cliente</dt><dd>{obra.cliente}</dd></div>}
      {obra.anio != null && <div><dt>Año</dt><dd>{obra.anio}</dd></div>}
      {obra.metros != null && <div><dt>Medición</dt><dd class="ficha__metros">{formatoMetros(obra.metros)}</dd></div>}
      {obra.tecnica && <div><dt>Técnica</dt><dd>{obra.tecnica}</dd></div>}
    </dl>
    {!compacta && obra.descripcion && <p class="ficha__descripcion">{obra.descripcion}</p>}
    <slot />
  </div>
</article>

<style>
  .ficha {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--c-blanco);
    border: 1px solid var(--c-linea);
    border-left: 4px solid var(--c-naranja);
    border-radius: var(--radio);
    box-shadow: 0 4px 14px rgba(120, 60, 10, 0.07);
    overflow: hidden;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .ficha__cuerpo { padding: var(--e-4) var(--e-5); display: flex; flex-direction: column; gap: var(--e-3); flex: 1; }
  .ficha__titulo { font-size: var(--fs-2); font-weight: 650; margin: 0; text-wrap: pretty; }
  .ficha__titulo a { color: inherit; text-decoration: none; }
  .ficha__titulo a:hover { color: var(--c-naranja-oscuro); text-decoration: underline; }
  .ficha__datos {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.5rem), 1fr));
    gap: var(--e-2) var(--e-4);
    font-size: var(--fs-0);
  }
  .ficha__datos div { min-width: 0; }
  .ficha__datos dt { color: var(--c-texto-suave); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .ficha__datos dd { margin: 0; color: var(--c-tinta); overflow-wrap: anywhere; }
  .ficha__metros { font-weight: 700; font-variant-numeric: tabular-nums; }
  .ficha__descripcion { margin: 0; color: var(--c-tinta); font-size: var(--fs-0); }

  .ficha__fotos { display: grid; gap: 2px; background: var(--c-linea); }
  .ficha__fotos--varias { grid-template-columns: repeat(3, 1fr); }
  .ficha__fotos--varias :global(.ficha__foto--principal) { grid-column: 1 / -1; }
  :global(.ficha__foto) { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  :global(.ficha__foto--principal) { aspect-ratio: 16 / 9; }
</style>
