---
/**
 * Ilustración decorativa: máquina de cimentación ejecutando inclusiones rígidas.
 * Procede de la rama `propuesta-grafico` (pendiente de aprobación por dirección).
 * Pensada para ir sobre FondoAero (trazos blancos y naranjas, con sombra poligonal en gris de marca). Usar una sola vez por página (ids de degradados).
 */
interface Props { class?: string }
const { class: clase } = Astro.props;
---
<svg class:list={["maquina", clase]} viewBox="0 0 620 460" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="gBlanco" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".95"/><stop offset="1" stop-color="#fff" stop-opacity=".55"/>
    </linearGradient>
    <linearGradient id="gCol" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".9"/><stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="gNar" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffb060"/><stop offset="1" stop-color="#e67717"/>
    </linearGradient>
    <linearGradient id="gBrillo" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity=".75"/><stop offset=".5" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <!-- inclusiones rígidas bajo el terreno -->
  <g fill="url(#gCol)">
    <rect x="96"  y="312" width="18" height="140" rx="9"/>
    <rect x="156" y="312" width="18" height="140" rx="9"/>
    <rect x="216" y="312" width="18" height="140" rx="9"/>
    <rect x="276" y="312" width="18" height="140" rx="9"/>
  </g>
  <!-- inclusión en ejecución, bajo la barrena -->
  <rect x="369" y="312" width="18" height="74" rx="9" fill="url(#gNar)" opacity=".9"/>

  <!-- línea de terreno -->
  <path d="M40 310 H600" stroke="#fff" stroke-opacity=".9" stroke-width="4" stroke-linecap="round"/>
  <path d="M40 320 H600" stroke="#fff" stroke-opacity=".35" stroke-width="2" stroke-linecap="round" stroke-dasharray="2 12"/>

  <!-- sombra poligonal en gris de marca (luz desde arriba a la izquierda), recortada en la línea de terreno -->
  <clipPath id="sobreTerreno"><rect x="0" y="0" width="620" height="308"/></clipPath>
  <g class="maquina__sombra" fill="#71706e" fill-opacity=".42" clip-path="url(#sobreTerreno)" transform="translate(16 11)">
    <polygon points="334,36 356,36 356,298 334,298"/>
    <polygon points="326,36 392,36 400,44 392,52 326,52"/>
    <polygon points="361,120 395,120 400,125 400,149 395,154 361,154 356,149 356,125"/>
    <polygon points="374,154 382,154 382,304 374,304"/>
    <polygon points="352,68 472,234 468,238 348,72"/>
    <polygon points="351,168 453,238 451,242 349,172"/>
    <polygon points="410,236 542,236 554,248 554,274 398,274 398,248"/>
    <polygon points="500,196 540,196 548,204 548,236 492,236 492,204"/>
    <polygon points="405,274 551,274 568,291 551,308 405,308 388,291"/>
  </g>

  <!-- máquina -->
  <g>
    <!-- mástil -->
    <rect x="334" y="36" width="22" height="262" rx="5" fill="url(#gBlanco)"/>
    <rect x="337" y="40" width="6" height="254" rx="3" fill="url(#gBrillo)"/>
    <!-- cabeza y poleas -->
    <path d="M326 36 h66 a8 8 0 0 1 0 16 h-66 z" fill="url(#gBlanco)"/>
    <circle cx="386" cy="44" r="9" fill="url(#gNar)"/><circle cx="386" cy="44" r="3" fill="#fff"/>
    <!-- cable y cabezal de rotación -->
    <path d="M386 53 V120" stroke="#fff" stroke-opacity=".8" stroke-width="2.5"/>
    <rect x="356" y="120" width="44" height="34" rx="7" fill="url(#gNar)"/>
    <rect x="359" y="123" width="38" height="12" rx="5" fill="url(#gBrillo)"/>
    <!-- útil de mezclado: eje con palas alternas y punta (giran alrededor del eje) -->
    <rect x="374" y="154" width="8" height="146" rx="3" fill="url(#gBlanco)"/>
    <polygon points="372,298 384,298 378,312" fill="#fff" fill-opacity=".95"/>
    <g class="maquina__palas" fill="#fff" fill-opacity=".92">
      <rect x="358" y="172" width="16" height="13" rx="1.5"/><rect x="382" y="166" width="16" height="13" rx="1.5"/>
      <rect x="358" y="208" width="16" height="13" rx="1.5"/><rect x="382" y="202" width="16" height="13" rx="1.5"/>
      <rect x="358" y="238" width="16" height="13" rx="1.5"/><rect x="382" y="232" width="16" height="13" rx="1.5"/>
      <rect x="358" y="270" width="16" height="13" rx="1.5"/><rect x="382" y="264" width="16" height="13" rx="1.5"/>
    </g>
    <!-- tirantes -->
    <path d="M350 70 L470 236" stroke="#fff" stroke-opacity=".85" stroke-width="5" stroke-linecap="round"/>
    <path d="M350 170 L452 240" stroke="#fff" stroke-opacity=".6" stroke-width="4" stroke-linecap="round"/>
    <!-- cuerpo y cabina -->
    <path d="M410 236 h132 a12 12 0 0 1 12 12 v26 h-156 v-26 a12 12 0 0 1 12 -12z" fill="url(#gNar)"/>
    <path d="M412 239 h128 a9 9 0 0 1 9 9 v4 h-146 v-4 a9 9 0 0 1 9 -9z" fill="url(#gBrillo)"/>
    <path d="M500 196 h40 a8 8 0 0 1 8 8 v32 h-56 v-32 a8 8 0 0 1 8 -8z" fill="url(#gBlanco)"/>
    <rect x="500" y="204" width="40" height="22" rx="4" fill="#e67717" opacity=".35"/>
    <!-- orugas -->
    <rect x="388" y="274" width="180" height="34" rx="17" fill="url(#gBlanco)"/>
    <rect x="394" y="280" width="168" height="22" rx="11" fill="#e67717" opacity=".28"/>
    <g fill="#fff"><circle cx="408" cy="291" r="8"/><circle cx="548" cy="291" r="8"/>
      <circle cx="443" cy="293" r="5"/><circle cx="478" cy="293" r="5"/><circle cx="513" cy="293" r="5"/></g>
  </g>
</svg>

<style>
  /* Las palas giran alrededor del eje: en alzado se ve como un vaivén de anchura (coseno). */
  .maquina__palas {
    transform-box: view-box;
    transform-origin: 378px 230px;
    animation: maquina-girar 1.8s ease-in-out infinite;
  }
  @keyframes maquina-girar {
    0%, 100% { transform: scaleX(1); }
    50% { transform: scaleX(-1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .maquina__palas { animation: none; }
  }
</style>
